# Local development only. Copy to .env only if you do not already have one.
# localhost works for a same-machine client. A physical phone needs the PC's
# LAN address, for example http://192.168.1.100:8000, and an API listening on
# 0.0.0.0. The phone and PC must be on the same network.
EXPO_PUBLIC_API_URL=http://localhost:8000

# This sample does not add the missing mobile login/navigation implementation.
